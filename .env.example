# Copy to .env and fill in. Never commit .env.

# --- Claude (required) -------------------------------------------------------
# Output of `claude setup-token` on a machine logged in to the Claude account.
CLAUDE_CODE_OAUTH_TOKEN=

# --- GitHub (required) -------------------------------------------------------
# Fine-grained token limited to the target repos: Contents RW, Pull requests RW,
# Actions R, Commit statuses R, Metadata R. No administration permission.
GITHUB_TOKEN=
# Identity used for every commit.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# --- Jira REST mode (default) --------------------------------------------------
# Atlassian Cloud site, for example https://yourco.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Jira MCP mode (optional, only for orgs that block API access) -----------------
# Host path of the JSON file describing the Jira MCP server (copy docker/jira-mcp.example.json), mounted into the worker.
JIRA_MCP_CONFIG_FILE=
# Path of that file inside the worker; set to /config/jira-mcp.json to turn MCP mode on.
JIRA_MCP_CONFIG_PATH=
# Credential the config refers to as ${JIRA_MCP_AUTH}: base64 of "email:scoped-api-token". Only the two Jira stages receive it.
JIRA_MCP_AUTH=
# Host added to the proxy's port 3129 allowlist, for example mcp.atlassian.com
JIRA_MCP_HOST=

# --- Dashboard and API (required) ---------------------------------------------
# The single login password (at least 12 characters). Hashed with argon2 at API startup.
DASHBOARD_PASSWORD=
# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false
# Address the dashboard port is published on.
DASHBOARD_BIND=127.0.0.1

# --- Database (required) -------------------------------------------------------
# DATABASE_URL is built from this in docker-compose.yml.
POSTGRES_PASSWORD=
# For local development outside Compose (npm run dev), point at the Compose postgres:
# DATABASE_URL=postgresql://sdlc:<POSTGRES_PASSWORD>@localhost:5432/sdlc

# --- Storage (required) ---------------------------------------------------------
# Absolute host path for mirrors, workspaces, runs and logs.
DATA_DIR=

# --- Agent containers (optional) ------------------------------------------------
# Agent image tag. Leave unset: a source build uses sdlc-agent/agent:latest, a release install uses the published image for SDLC_VERSION.
# AGENT_IMAGE=
# Limits per agent container.
AGENT_MEMORY=4g
AGENT_CPUS=2

# --- Logging (optional) ----------------------------------------------------------
# pino level: trace, debug, info, warn, error
LOG_LEVEL=info

# --- Release install (optional) ---------------------------------------------------
# Used only by deploy/docker-compose.yml (the compose file inside a release bundle); ignored when you run from source.
# The release to run, without the leading v (for example 0.0.0).
SDLC_VERSION=
SDLC_REGISTRY=ghcr.io/pjx16
