#!/usr/bin/env bash
# Runs one AI stage (BUILD_PLAN 6.4). Everything comes from the read-only /context directory
# written by the worker: stage.json, prompt.md, system.md, schema.json.
# CONTEXT_DIR and WORKSPACE_DIR can be overridden for tests.
set -euo pipefail
# The workspace is shared with the worker, which runs as another user (root in Docker, a normal user in development or CI).
# Files and folders made here must stay readable, writable and deletable by it, so do not let a restrictive umask hide them.
umask 000

CONTEXT_DIR="${CONTEXT_DIR:-/context}"
WORKSPACE_DIR="${WORKSPACE_DIR:-/workspace}"

for f in stage.json prompt.md system.md schema.json; do
  [ -f "$CONTEXT_DIR/$f" ] || { echo "run-stage: missing $CONTEXT_DIR/$f" >&2; exit 64; }
done

MODEL="$(jq -r '.model' "$CONTEXT_DIR/stage.json")"
MAX_TURNS="$(jq -r '.maxTurns' "$CONTEXT_DIR/stage.json")"
DISALLOWED_TOOLS="$(jq -r '(.disallowedTools // []) | join(",")' "$CONTEXT_DIR/stage.json")"

args=(
  -p
  --model "$MODEL"
  --max-turns "$MAX_TURNS"
  --output-format stream-json --verbose
  --json-schema "$(cat "$CONTEXT_DIR/schema.json")"
  --append-system-prompt "$(cat "$CONTEXT_DIR/system.md")"
  --disallowedTools "$DISALLOWED_TOOLS"
  --dangerously-skip-permissions
)

# The assistant continues its conversation's CLI session.
RESUME="$(jq -r '.resumeSession // empty' "$CONTEXT_DIR/stage.json")"
if [ -n "$RESUME" ]; then
  args+=(--resume "$RESUME")
fi

# Extended thinking only where the worker asks for it (the orchestrator at a decision point).
THINKING="$(jq -r '.thinkingTokens // empty' "$CONTEXT_DIR/stage.json")"
if [ -n "$THINKING" ]; then
  export MAX_THINKING_TOKENS="$THINKING"
fi

# A stage without a workspace runs in the context directory.
if [ -d "$WORKSPACE_DIR" ]; then
  cd "$WORKSPACE_DIR"
fi

exec claude "${args[@]}" < "$CONTEXT_DIR/prompt.md"
