#!/usr/bin/env bash
# Runs one verification command (install, typecheck, tests) in the workspace, without the Claude token.
# CMD is the command line; VERIFY_TIMEOUT (seconds, default 600) bounds it. Exit code 124 means timeout.
set -uo pipefail
# See run-stage: what installs and tests create in the shared workspace must stay accessible to the worker's user.
umask 000

: "${CMD:?run-cmd: CMD is required}"
WORKSPACE_DIR="${WORKSPACE_DIR:-/workspace}"
cd "$WORKSPACE_DIR" || { echo "run-cmd: cannot enter $WORKSPACE_DIR" >&2; exit 66; }

exec timeout "${VERIFY_TIMEOUT:-600}" bash -lc "$CMD"
