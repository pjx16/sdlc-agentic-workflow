generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Dashboard login session. Only the SHA-256 of the token is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  ip        String
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
